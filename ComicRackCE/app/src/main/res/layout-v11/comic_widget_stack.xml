<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/comicStackViewFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <StackView
        android:gravity="center"
        android:id="@+id/comicStackView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:loopViews="true"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/comicStackEmptyView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/empty_list"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom|right"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/widgetRefresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/btn_refresh"
            android:scaleType="fitCenter"/>
        <ImageView
            android:id="@+id/widgetWifi"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/btn_wifi"
            android:scaleType="fitCenter"/>
        <ImageView
            android:id="@+id/widgetConfigure"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/icon"/>
    </LinearLayout>
</FrameLayout>
